// Utility AI голубя: каталог намерений MVP-1 (ТЗ §9.2).
//
// Оценка варианта = произведение considerations (с поправкой на их число)
//                 × вес трейтов × модификатор настроения × (1 + momentum для текущего намерения).
//
// consideration: input — что измеряем; curve — constant | linear | smoothstep | power;
//   вход x переводится в t = (x − from) / (to − from) в пределах 0..1, затем в min..max.
//   from > to — кривая убывает. Входы: need.fatigue, need.boredom, need.attention,
//   mood.valence (−1..1), mood.arousal, mood.stress, target.attractiveness,
//   target.risk (с поправкой на Boldness), target.travel (путь / travelCostScaleSeconds).
// traits: вес w даёт множитель 1 + w · (трейт − 50) / 50.
// mood: множитель 1 + arousal · (2·arousal − 1) + valence · valence.
// needs: как намерение меняет потребности; > 0 — рост во столько раз, < 0 — снижение,
//   0 — потребность стоит (см. NeedEffects).
// Изменение значений меняет эталонный хеш симуляции (ADR-0016).
{
  "selection": {
    "topK": 3,
    "delta": 0.1,
    "momentum": 0.25,
    "travelCostScaleSeconds": 60
  },
  "intents": {
    "wander": {
      "considerations": [
        { "curve": "constant", "value": 0.3 },
        { "input": "need.fatigue", "curve": "linear", "from": 1.0, "to": 0.4, "min": 0.2, "max": 1.0 }
      ],
      "traits": { "energy": 0.3 },
      "durationSeconds": [30, 90],
      "cooldownSeconds": 0,
      "needs": { "fatigue": 1.0, "boredom": 1.0, "attention": 1.0 }
    },
    "rest": {
      "considerations": [
        { "input": "need.fatigue", "curve": "smoothstep", "from": 0.4, "to": 0.85 }
      ],
      "traits": { "energy": -0.3, "calmness": 0.2 },
      "mood": { "arousal": -0.3 },
      "durationSeconds": [60, 180],
      "cooldownSeconds": 120,
      "needs": { "fatigue": -0.3, "boredom": 1.0, "attention": 1.0 }
    },
    "sleep": {
      "considerations": [
        { "input": "need.fatigue", "curve": "smoothstep", "from": 0.4, "to": 0.8 },
        { "input": "mood.arousal", "curve": "linear", "from": 0.7, "to": 0.2, "min": 0.3, "max": 1.0 }
      ],
      "traits": { "energy": -0.3 },
      "durationSeconds": [600, 1200],
      "cooldownSeconds": 3600,
      "needs": { "fatigue": -1.6, "boredom": 0.0, "attention": 0.3 }
    },
    "groom": {
      "considerations": [
        { "curve": "constant", "value": 0.3 },
        { "input": "mood.stress", "curve": "linear", "from": 0.0, "to": 0.5, "min": 0.6, "max": 1.0 }
      ],
      "traits": { "calmness": 0.3 },
      "durationSeconds": [20, 45],
      "cooldownSeconds": 300,
      "needs": { "fatigue": 0.4, "boredom": 0.5, "attention": 1.0 }
    },
    "explore": {
      "targets": ["pointOfInterest", "perchSpot", "restSpot"],
      "considerations": [
        { "input": "need.boredom", "curve": "smoothstep", "from": 0.1, "to": 0.7, "min": 0.15, "max": 1.0 },
        { "input": "target.attractiveness", "curve": "linear", "min": 0.4, "max": 1.0 },
        { "input": "target.risk", "curve": "linear", "from": 1.0, "to": 0.0, "min": 0.1, "max": 1.0 },
        { "input": "target.travel", "curve": "linear", "from": 1.0, "to": 0.0, "min": 0.5, "max": 1.0 }
      ],
      "traits": { "curiosity": 0.6, "boldness": 0.2 },
      "durationSeconds": [40, 120],
      "cooldownSeconds": 90,
      "needs": { "fatigue": 1.3, "boredom": -2.5, "attention": 1.0 }
    },
    "observe": {
      "targets": ["pointOfInterest", "attentionTarget"],
      "considerations": [
        { "input": "need.boredom", "curve": "smoothstep", "from": 0.1, "to": 0.6, "min": 0.2, "max": 1.0 },
        { "input": "target.attractiveness", "curve": "linear", "min": 0.3, "max": 1.0 },
        { "input": "need.fatigue", "curve": "linear", "from": 0.0, "to": 1.0, "min": 0.5, "max": 1.0 }
      ],
      "traits": { "curiosity": 0.3, "calmness": 0.3 },
      "durationSeconds": [15, 40],
      "cooldownSeconds": 90,
      "needs": { "fatigue": 0.4, "boredom": -0.5, "attention": 1.0 }
    },
    "seekAttention": {
      "targets": ["attentionTarget"],
      "considerations": [
        { "input": "need.attention", "curve": "smoothstep", "from": 0.3, "to": 0.9 },
        { "input": "target.travel", "curve": "linear", "from": 1.0, "to": 0.0, "min": 0.4, "max": 1.0 }
      ],
      "traits": { "sociability": 0.6, "independence": -0.6 },
      "durationSeconds": [20, 45],
      "cooldownSeconds": 300,
      "needs": { "fatigue": 0.6, "boredom": 1.0, "attention": 1.0 }
    },
    "followTarget": {
      "targets": ["attentionTarget"],
      "considerations": [
        { "input": "need.boredom", "curve": "smoothstep", "from": 0.2, "to": 0.7, "min": 0.2, "max": 1.0 },
        { "input": "target.attractiveness", "curve": "linear", "min": 0.2, "max": 1.0 },
        { "input": "mood.arousal", "curve": "linear", "from": 0.2, "to": 0.8, "min": 0.3, "max": 1.0 }
      ],
      "traits": { "playfulness": 0.4, "curiosity": 0.2, "independence": -0.3 },
      "durationSeconds": [15, 40],
      "cooldownSeconds": 120,
      "needs": { "fatigue": 1.3, "boredom": -2.0, "attention": 0.5 }
    },
    "play": {
      "targets": ["attentionTarget"],
      "considerations": [
        { "input": "need.boredom", "curve": "smoothstep", "from": 0.1, "to": 0.6, "min": 0.15, "max": 1.0 },
        { "input": "need.fatigue", "curve": "linear", "from": 1.0, "to": 0.4 },
        { "input": "mood.valence", "curve": "linear", "from": -0.5, "to": 0.5, "min": 0.5, "max": 1.0 }
      ],
      "traits": { "playfulness": 0.7, "energy": 0.3 },
      "mood": { "arousal": 0.2 },
      "durationSeconds": [30, 90],
      "cooldownSeconds": 240,
      "needs": { "fatigue": 1.6, "boredom": -3.0, "attention": 0.5 }
    },
    "relocate": {
      "targets": ["territoryZone"],
      "considerations": [
        { "input": "need.boredom", "curve": "smoothstep", "from": 0.1, "to": 0.6, "min": 0.2, "max": 1.0 },
        { "input": "target.attractiveness", "curve": "linear", "min": 0.4, "max": 1.0 },
        { "input": "target.travel", "curve": "linear", "from": 1.0, "to": 0.0, "min": 0.5, "max": 1.0 },
        { "input": "need.fatigue", "curve": "linear", "from": 0.9, "to": 0.4, "min": 0.2, "max": 1.0 }
      ],
      "traits": { "curiosity": 0.3, "energy": 0.3, "boldness": 0.2 },
      "durationSeconds": [20, 40],
      "cooldownSeconds": 600,
      "needs": { "fatigue": 2.0, "boredom": -2.0, "attention": 1.0 }
    },
    "flee": {
      "targets": ["attentionTarget", "hazard"],
      "considerations": [
        { "input": "target.risk", "curve": "linear", "from": 0.05, "to": 0.6, "min": 0.1, "max": 1.0 },
        { "input": "mood.valence", "curve": "linear", "from": 0.4, "to": -0.4, "min": 0.4, "max": 1.0 },
        { "input": "mood.arousal", "curve": "linear", "from": 0.2, "to": 0.8, "min": 0.5, "max": 1.0 }
      ],
      "traits": { "boldness": -0.6, "calmness": -0.3, "sociability": -0.2 },
      "durationSeconds": [8, 20],
      "cooldownSeconds": 60,
      "needs": { "fatigue": 1.2, "boredom": 1.0, "attention": 1.0 }
    }
  }
}
