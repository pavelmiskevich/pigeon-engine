<Project Sdk="Microsoft.NET.Sdk.WebAssembly">

  <!--
    Браузерный харнесс B0 (MVP-0, S0.7; ADR-0014, ADR-0016): ядро на .NET WebAssembly без Blazor,
    JSImport/JSExport. Собирается без workload (интерпретатор, без AOT и нативного релинка),
    поэтому входит в общее решение и собирается на всех платформах CI. В браузере запускается
    отдельной джобой CI: tools/wasm-check.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>full</TrimMode>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Pigeon.Simulation/Pigeon.Simulation.csproj" />
    <ProjectReference Include="../../src/Pigeon.World.City.Generation/Pigeon.World.City.Generation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../Shared/GoldenSimulation.cs" Link="Shared/GoldenSimulation.cs" />
    <Compile Include="../Shared/GoldenCity.cs" Link="Shared/GoldenCity.cs" />
  </ItemGroup>

</Project>
